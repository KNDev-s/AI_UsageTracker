# Environment
APP_ENV=development
APP_NAME="AI Usage Tracker"
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_USER=ai_tracker_owner
POSTGRES_PASSWORD=ai_tracker_dev_password
POSTGRES_DB=ai_usage_tracker
# Migrations / owner URL (table owner for Alembic)
DATABASE_MIGRATION_URL=postgresql+psycopg://ai_tracker_owner:ai_tracker_dev_password@postgres:5432/ai_usage_tracker
# Runtime API URL (non-BYPASSRLS role enforcing Row-Level Security)
DATABASE_URL=postgresql+psycopg://ai_tracker_app:ai_tracker_app_dev_password@postgres:5432/ai_usage_tracker
APP_DB_USER=ai_tracker_app
APP_DB_PASSWORD=ai_tracker_app_dev_password

# Security & Encryption
SECRET_KEY=dev-only-secret-key-change-in-production-32bytes-min
# 32-byte key encoded in URL-safe base64 (for Phase 2 BYOK AES-256-GCM)
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ENCRYPTION_KEY_VERSION=1

# Sessions & Cookies
SESSION_COOKIE_NAME=ai_tracker_session
CSRF_COOKIE_NAME=ai_tracker_csrf
SESSION_TTL_HOURS=168
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate Limiting
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# SMTP / Transactional Email (Mailpit in local dev)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aiusagetracker.local
SMTP_USE_TLS=false

# Google OAuth 2.0 / OpenID Connect (leave blank to disable button or configure credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

